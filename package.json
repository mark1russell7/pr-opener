{
  "$schema": "https://json.schemastore.org/package",
  "name": "pr-opener",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "",
  "main": "index.js",
  "scripts": {
    "build": "esbuild src/background.ts src/options.ts --bundle --format=esm --platform=browser --target=es2024 --outdir=dist && node scripts/check-bundle.ts",
    "watch": "esbuild src/background.ts src/options.ts --bundle --format=esm --platform=browser --target=es2024 --outdir=dist --watch",
    "typecheck": "tsc --noEmit && pnpm --filter @pr-opener/site run typecheck",
    "test": "pnpm --filter @pr-opener/site run test"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@10.34.9",
  "dependencies": {
    "@mark1russell7/text": "^0.0.5"
  },
  "devDependencies": {
    "@types/chrome": "^0.1.36",
    "@vitest/coverage-v8": "^5.0.3",
    "esbuild": "^0.28.2",
    "typescript": "^5.9.3"
  }
}
