{
  "$schema": "https://json.schemastore.org/package",
  "name": "@pr-opener/site",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "The GitHub Pages site of pr-opener: the real extension code runs in the page against a stand-in of the chrome APIs.",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.test.json"
  },
  "dependencies": {
    "@mark1russell7/site-pages": "^0.2.0"
  },
  "devDependencies": {
    "@types/chrome": "^0.1.36",
    "@types/node": "^25.0.2",
    "jsdom": "^30.1.3",
    "typescript": "^5.9.3",
    "vite": "^8.3.5",
    "vitest": "^5.0.3"
  }
}
